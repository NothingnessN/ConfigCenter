From: NothingnessN <NothingnessN@users.noreply.github.com>
Date: Wed, 25 Nov 2026 08:17:31 +0300
Subject: [PATCH] Settings: rebrand visible Havoc text as D4RK OS

---
 res/values/havoc_strings.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/res/values/havoc_strings.xml b/res/values/havoc_strings.xml
index 7b0633d..3213b2c 100644
--- a/res/values/havoc_strings.xml
+++ b/res/values/havoc_strings.xml
@@ -17,7 +17,7 @@
 <resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
 
     <!-- Havoc-OS -->
-    <string name="havoc_title" translatable="false">Havoc-OS</string>
+    <string name="havoc_title" translatable="false">D4RK OS</string>
     <string name="about_device_name">Device</string>
 
     <!-- Units -->
@@ -27,7 +27,7 @@
     <string name="unit_hz">hz</string>
 
     <!-- About phone screen, Havoc-OS version -->
-    <string name="havoc_version">Havoc-OS version</string>
+    <string name="havoc_version">D4RK OS version</string>
     <string name="havoc_version_default">Unknown</string>
     <string name="havoc_version_summary">Version %1$s (%2$s)</string>
 
